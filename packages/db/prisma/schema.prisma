// LifeDesk — Phase 2 schema.
//
// Mirrors packages/contracts exactly. The contracts are the source of truth for
// shape; this file is how that shape is stored. If they disagree, one is a bug.
//
// Two conventions worth knowing before editing:
//
//   1. Calendar days (`scheduledFor`, `dueDate`, `startDate`) are VarChar(10)
//      holding "YYYY-MM-DD", NOT Postgres `date`. A calendar day is a day in
//      the user's calendar with no time and no zone; Prisma surfaces a `date`
//      column as a JS Date at UTC midnight, which is precisely the "Thursday
//      renders as Wednesday evening" bug .claude/rules/dates-and-timezones.md
//      exists to prevent. ISO strings sort lexicographically == chronologically
//      so ordering and BETWEEN still work, and every day calculation lives in
//      packages/core/time rather than in SQL.
//
//   2. Instants (`startedAt`, `completedAt`, …) are timestamptz, always UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// Prisma 7 no longer accepts `url` here. Migrations read their connection from
// prisma.config.ts; the running app passes a driver adapter instead.
datasource db {
  provider = "postgresql"
}

// ─── enums ──────────────────────────────────────────────────────────────────

/// Fixed eight-hue palette, so an area looks identical in every list and chart.
enum AreaColor {
  clay
  amber
  olive
  teal
  indigo
  plum
  rose
  slate
}

enum TaskStatus {
  todo
  doing
  done
  cancelled
}

enum TaskPriority {
  none
  low
  medium
  high
}

enum ProjectStatus {
  active
  paused
  done
}

enum SessionSource {
  timer
  pomodoro
  manual
}

enum Theme {
  light
  dark
  system
}

// ─── auth ───────────────────────────────────────────────────────────────────

/// Owned by Better Auth from step 18; these are the fields it provides.
/// Its Session / Account / Verification tables are generated by its own CLI so
/// the field names match the version we install rather than a guess.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  settings UserSettings?
  areas    Area[]
  projects Project[]
  tasks    Task[]
  tags     Tag[]
  sessions TimeSession[]

  @@map("user")
}

// ─── settings ───────────────────────────────────────────────────────────────

model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// IANA zone. The source of truth for "today" — never the browser's clock.
  timezone         String @default("Europe/London")
  /// 0 = Sunday … 6 = Saturday, matching date-fns.
  weekStartsOn     Int    @default(1)
  /// Soft cap for the capacity meter. Informs, never blocks.
  dailyCapacityMin Int    @default(360)

  pomodoroWorkMin Int @default(25)
  shortBreakMin   Int @default(5)
  longBreakMin    Int @default(15)
  longBreakEvery  Int @default(4)

  soundEnabled   Boolean @default(true)
  tickingEnabled Boolean @default(false)
  theme          Theme   @default(system)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("user_settings")
}

// ─── planning ───────────────────────────────────────────────────────────────

model Area {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color AreaColor
  icon  String?

  sortOrder Int      @default(0)
  /// Soft delete — a stray click must not orphan months of tracked time.
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  projects Project[]
  tasks    Task[]
  sessions TimeSession[]

  @@index([userId, sortOrder])
  @@map("area")
}

model Project {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String?
  /// Losing an area must not delete the work inside it.
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      ProjectStatus @default(active)

  /// Calendar days — see the header note.
  startDate String? @db.VarChar(10)
  dueDate   String? @db.VarChar(10)

  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  tasks    Task[]
  sessions TimeSession[]

  @@index([userId, areaId])
  @@index([userId, status])
  @@map("project")
}

model Task {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// One level of nesting only — deep trees are where planners go to die.
  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  title    String
  notes    String?
  status   TaskStatus   @default(todo)
  priority TaskPriority @default(none)

  /// Minutes the user expects this to take. Compared against tracked time.
  estimateMin Int?
  /// The day this is committed to. Distinct from when it is due.
  scheduledFor String? @db.VarChar(10)
  dueDate      String? @db.VarChar(10)

  /// When on that day the time is set aside — a block on the grid. Minutes
  /// from local midnight, so it cannot drift when the user travels. Both null
  /// or both set; only meaningful alongside `scheduledFor`.
  plannedStartMin Int?
  plannedEndMin   Int?

  completedAt DateTime? @db.Timestamptz(3)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  tags     TaskTag[]
  sessions TimeSession[]

  /// The two reads every screen makes.
  @@index([userId, scheduledFor])
  @@index([userId, status])
  @@index([userId, projectId])
  @@map("task")
}

model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  color     AreaColor
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  tasks TaskTag[]

  @@unique([userId, name])
  @@map("tag")
}

model TaskTag {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tag")
}

// ─── tracking ───────────────────────────────────────────────────────────────

/// A tracked stretch of work.
///
/// `areaId` and `projectId` are denormalized here on purpose, captured when the
/// session starts: move a task to a different project later and last month's
/// report must not silently rewrite itself. For the same reason deleting a task
/// nulls the link rather than cascading — the time was still spent.
model TimeSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  startedAt DateTime  @db.Timestamptz(3)
  /// Null means running. At most one per user — enforced by a partial unique
  /// index added in the migration, since Prisma cannot express one.
  endedAt   DateTime? @db.Timestamptz(3)
  /// Integer seconds, set on stop. Null while running.
  durationSec Int?

  source SessionSource @default(timer)
  note   String?
  /// Ran past the runaway threshold — almost always a timer left running.
  /// Flagged for review rather than silently logging fourteen hours.
  needsReview Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, startedAt])
  @@index([userId, taskId])
  @@map("time_session")
}

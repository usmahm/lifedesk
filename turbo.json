{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "LIFEDESK_REPOS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SEED_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "test": {
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}

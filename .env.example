# Neon Postgres. Create a project at https://console.neon.tech and copy both
# connection strings — they are different endpoints, not a formatting choice.
#
#   DATABASE_URL  pooled   (hostname contains "-pooler")  → the running app
#   DIRECT_URL    unpooled (no "-pooler")                 → migrations only
#
# Neon's pooler cannot execute DDL, so `prisma migrate` needs the direct one.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
